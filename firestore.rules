rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles & roles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || request.resource.data.role != null);
    }

    // Industrial Sites (Substations, Plants, Towers)
    match /sites/{siteId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // ESP32 Earth Resistance Monitoring Devices
    match /devices/{deviceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Live Telemetry & Historical Readings (earthResistance Ω, RSSI, soil temp, battery)
    match /telemetry/{readingId} {
      allow read: if true;
      allow create: if true; // allow ESP32 gateway ingestion
      allow update, delete: if isAuthenticated();
    }

    // Alarms & Threshold Excursions
    match /alarms/{alarmId} {
      allow read: if true;
      allow create: if true; // generated by ingestion
      allow update, delete: if isAuthenticated();
    }

    // IEEE / IEC / IS Compliance Threshold Profiles
    match /threshold_rules/{ruleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Industrial Safety & Calibration Audit Logs (OSHA / NFPA 70E / IEC 62305)
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAuthenticated();
    }
  }
}
